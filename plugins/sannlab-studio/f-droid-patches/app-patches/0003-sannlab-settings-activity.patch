+package com.termux.app.sannlab;
+
+import android.content.ContentResolver;
+import android.graphics.Typeface;
+import android.net.Uri;
+import android.os.Bundle;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.webkit.MimeTypeMap;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.RadioButton;
+import android.widget.RadioGroup;
+import android.widget.ScrollView;
+import android.widget.SeekBar;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.activity.result.ActivityResultLauncher;
+import androidx.activity.result.contract.ActivityResultContracts;
+import androidx.appcompat.app.AppCompatActivity;
+import androidx.appcompat.widget.SwitchCompat;
+
+import com.termux.shared.termux.TermuxConstants;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * SannLab Studio appearance settings.
+ *
+ * <p>A deliberately simple, fully programmatic settings screen (v1): no layout
+ * XML, no new Android permissions. Files are chosen with the system document
+ * picker ({@link ActivityResultContracts.OpenDocument}); the picker grant is the
+ * only access used. Picks are copied into app-owned storage:</p>
+ * <ul>
+ *     <li>background image/video → {@code $HOME/.termux/sannlab/} and the choice is
+ *     persisted as {@code sannlab.*} keys in {@code termux.properties}</li>
+ *     <li>font → {@code $HOME/.termux/font.ttf}, the exact file upstream's
+ *     {@code checkForFontAndColors()} loads, so the existing Termux font mechanism
+ *     applies it (on the terminal activity's next resume)</li>
+ * </ul>
+ *
+ * <p>Every change is written to the properties file immediately; the terminal
+ * re-reads it in {@code onResume}, so changes take effect when the user returns
+ * to the terminal, without restarting the app.</p>
+ */
+public class SannLabSettingsActivity extends AppCompatActivity {
+
+    private TextView mStatusText;
+    private ActivityResultLauncher<String[]> mImagePicker;
+    private ActivityResultLauncher<String[]> mVideoPicker;
+    private ActivityResultLauncher<String[]> mFontPicker;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        mImagePicker = registerForActivityResult(new ActivityResultContracts.OpenDocument(),
+            uri -> { if (uri != null) copyPickedMedia(uri, false); });
+        mVideoPicker = registerForActivityResult(new ActivityResultContracts.OpenDocument(),
+            uri -> { if (uri != null) copyPickedMedia(uri, true); });
+        mFontPicker = registerForActivityResult(new ActivityResultContracts.OpenDocument(),
+            uri -> { if (uri != null) copyPickedFont(uri); });
+
+        SannLabConfig config = SannLabConfig.load();
+
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        int pad = dp(16);
+        root.setPadding(pad, pad, pad, pad);
+
+        TextView title = new TextView(this);
+        title.setText("SannLab Studio — Wallpaper & Appearance");
+        title.setTextSize(18);
+        title.setPadding(0, 0, 0, dp(4));
+        root.addView(title);
+
+        mStatusText = new TextView(this);
+        mStatusText.setPadding(0, 0, 0, dp(12));
+        root.addView(mStatusText);
+
+        root.addView(makeButton("Pick background image (JPG/PNG/WebP)",
+            v -> mImagePicker.launch(new String[]{"image/*"})));
+        root.addView(makeButton("Pick background video (MP4/WebM)",
+            v -> mVideoPicker.launch(new String[]{"video/*"})));
+        root.addView(makeButton("Pick terminal font (.ttf/.otf)",
+            v -> mFontPicker.launch(new String[]{"*/*"})));
+        root.addView(makeButton("No background (plain terminal)",
+            v -> applyUpdates(singleEntry(SannLabConfig.KEY_TYPE, SannLabConfig.TYPE_NONE),
+                "Background disabled")));
+
+        addSlider(root, "Wallpaper opacity", 0, 100, config.opacity, value ->
+            applyUpdates(singleEntry(SannLabConfig.KEY_OPACITY, String.valueOf(value)), null));
+        addSlider(root, "Black overlay (readability)", 0, 100, config.overlay, value ->
+            applyUpdates(singleEntry(SannLabConfig.KEY_OVERLAY, String.valueOf(value)), null));
+        // SeekBar range is 0..100; brightness maps to 50..150 percent.
+        addSlider(root, "Brightness", 0, 100, config.brightness - 50, value ->
+            applyUpdates(singleEntry(SannLabConfig.KEY_BRIGHTNESS, String.valueOf(value + 50)), null));
+        addSlider(root, "Blur radius (Android 12+ only)", 0, 25, config.blur, value ->
+            applyUpdates(singleEntry(SannLabConfig.KEY_BLUR, String.valueOf(value)), null));
+
+        TextView scaleLabel = new TextView(this);
+        scaleLabel.setText("Scaling");
+        scaleLabel.setPadding(0, dp(12), 0, 0);
+        root.addView(scaleLabel);
+        RadioGroup scaleGroup = new RadioGroup(this);
+        scaleGroup.setOrientation(RadioGroup.HORIZONTAL);
+        RadioButton crop = new RadioButton(this);
+        crop.setText("Center crop");
+        RadioButton fit = new RadioButton(this);
+        fit.setText("Fit center");
+        scaleGroup.addView(crop);
+        scaleGroup.addView(fit);
+        (SannLabConfig.SCALE_FIT_CENTER.equals(config.scale) ? fit : crop).setChecked(true);
+        scaleGroup.setOnCheckedChangeListener((group, checkedId) ->
+            applyUpdates(singleEntry(SannLabConfig.KEY_SCALE,
+                checkedId == fit.getId() ? SannLabConfig.SCALE_FIT_CENTER : SannLabConfig.SCALE_CENTER_CROP), null));
+        root.addView(scaleGroup);
+
+        TextView fpsLabel = new TextView(this);
+        fpsLabel.setText("Video frame-rate cap");
+        fpsLabel.setPadding(0, dp(12), 0, 0);
+        root.addView(fpsLabel);
+        RadioGroup fpsGroup = new RadioGroup(this);
+        fpsGroup.setOrientation(RadioGroup.HORIZONTAL);
+        int[] fpsValues = {0, 15, 24, 30};
+        String[] fpsLabels = {"Off", "15", "24", "30"};
+        RadioButton[] fpsButtons = new RadioButton[fpsValues.length];
+        for (int i = 0; i < fpsValues.length; i++) {
+            fpsButtons[i] = new RadioButton(this);
+            fpsButtons[i].setText(fpsLabels[i]);
+            final int fpsValue = fpsValues[i];
+            fpsButtons[i].setTag(fpsValue);
+            fpsGroup.addView(fpsButtons[i]);
+            if (config.fps == fpsValue) fpsButtons[i].setChecked(true);
+        }
+        if (config.fps == 0) fpsButtons[0].setChecked(true);
+        fpsGroup.setOnCheckedChangeListener((group, checkedId) -> {
+            RadioButton selected = group.findViewById(checkedId);
+            if (selected != null && selected.getTag() instanceof Integer)
+                applyUpdates(singleEntry(SannLabConfig.KEY_FPS, String.valueOf(selected.getTag())), null);
+        });
+        root.addView(fpsGroup);
+
+        SwitchCompat amoledSwitch = new SwitchCompat(this);
+        amoledSwitch.setText("AMOLED pure black (#000000)");
+        amoledSwitch.setPadding(0, dp(16), 0, 0);
+        amoledSwitch.setChecked(config.amoled);
+        amoledSwitch.setOnCheckedChangeListener((button, isChecked) ->
+            applyUpdates(singleEntry(SannLabConfig.KEY_AMOLED, String.valueOf(isChecked)), null));
+        root.addView(amoledSwitch);
+
+        TextView hint = new TextView(this);
+        hint.setText("Changes are saved to termux.properties immediately and apply when you " +
+            "return to the terminal. The font applies through the standard Termux font " +
+            "mechanism (font.ttf). Video wallpaper is muted and pauses automatically " +
+            "when the terminal is not visible.");
+        hint.setPadding(0, dp(16), 0, 0);
+        root.addView(hint);
+
+        ScrollView scrollView = new ScrollView(this);
+        scrollView.addView(root);
+        setContentView(scrollView);
+
+        refreshStatus();
+    }
+
+    // ------------------------------------------------------------------ picking & copying
+
+    private void copyPickedMedia(Uri uri, boolean isVideo) {
+        new Thread(() -> {
+            try {
+                String extension = extensionFor(uri, isVideo ? "mp4" : "jpg");
+                File dir = SannLabConfig.getMediaDir();
+                if (!dir.exists() && !dir.mkdirs()) throw new IOException("Cannot create " + dir);
+                String baseName = isVideo ? "background_video." : "background_image.";
+                // Remove a previously picked file of the same kind so stale files
+                // (also used by the video error fallback) cannot linger.
+                File[] existing = dir.listFiles();
+                if (existing != null) {
+                    for (File f : existing) {
+                        if (f.getName().startsWith(baseName)) {
+                            //noinspection ResultOfMethodCallIgnored
+                            f.delete();
+                        }
+                    }
+                }
+                File target = new File(dir, baseName + extension);
+                copyUriToFile(uri, target);
+                Map<String, String> updates = new HashMap<>();
+                updates.put(SannLabConfig.KEY_TYPE, isVideo ? SannLabConfig.TYPE_VIDEO : SannLabConfig.TYPE_IMAGE);
+                updates.put(SannLabConfig.KEY_PATH, target.getAbsolutePath());
+                SannLabConfig.update(updates);
+                runOnUiThread(() -> {
+                    refreshStatus();
+                    toast((isVideo ? "Video" : "Image") + " background saved");
+                });
+            } catch (Exception e) {
+                runOnUiThread(() -> toast("Failed to save background: " + e.getMessage()));
+            }
+        }, "sannlab-copy-media").start();
+    }
+
+    private void copyPickedFont(Uri uri) {
+        String name = uri.getLastPathSegment();
+        String lower = name == null ? "" : name.toLowerCase();
+        if (!lower.endsWith(".ttf") && !lower.endsWith(".otf")) {
+            toast("Please pick a .ttf or .otf font file");
+            return;
+        }
+        new Thread(() -> {
+            try {
+                File target = TermuxConstants.TERMUX_FONT_FILE;
+                File parent = target.getParentFile();
+                if (parent != null && !parent.exists() && !parent.mkdirs())
+                    throw new IOException("Cannot create " + parent);
+                copyUriToFile(uri, target);
+                // Sanity check with the same API upstream uses to load the font.
+                if (Typeface.createFromFile(target) == null)
+                    throw new IOException("Font file could not be parsed");
+                runOnUiThread(() -> toast("Font saved — applies when the terminal reloads"));
+            } catch (Exception e) {
+                runOnUiThread(() -> toast("Failed to save font: " + e.getMessage()));
+            }
+        }, "sannlab-copy-font").start();
+    }
+
+    private void copyUriToFile(Uri uri, File target) throws IOException {
+        ContentResolver resolver = getContentResolver();
+        try (InputStream in = resolver.openInputStream(uri);
+             OutputStream out = new FileOutputStream(target)) {
+            if (in == null) throw new IOException("Cannot open " + uri);
+            byte[] buffer = new byte[64 * 1024];
+            int read;
+            while ((read = in.read(buffer)) != -1) {
+                out.write(buffer, 0, read);
+            }
+        }
+    }
+
+    private String extensionFor(Uri uri, String fallback) {
+        String mime = getContentResolver().getType(uri);
+        String ext = mime == null ? null : MimeTypeMap.getSingleton().getExtensionFromMimeType(mime);
+        if (ext == null || ext.isEmpty()) {
+            String segment = uri.getLastPathSegment();
+            if (segment != null) {
+                int dot = segment.lastIndexOf('.');
+                if (dot >= 0 && dot < segment.length() - 1) ext = segment.substring(dot + 1);
+            }
+        }
+        return (ext == null || ext.isEmpty()) ? fallback : ext.toLowerCase();
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    private interface SliderListener {
+        void onValue(int value);
+    }
+
+    private void addSlider(LinearLayout root, String label, int min, int max, int value, SliderListener listener) {
+        TextView labelView = new TextView(this);
+        labelView.setText(label + ": " + (label.startsWith("Brightness") ? (value + 50) : value));
+        labelView.setPadding(0, dp(12), 0, 0);
+        root.addView(labelView);
+
+        SeekBar seekBar = new SeekBar(this);
+        seekBar.setMax(max - min);
+        seekBar.setProgress(value - min);
+        seekBar.setLayoutParams(new LinearLayout.LayoutParams(
+            ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        seekBar.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(SeekBar bar, int progress, boolean fromUser) {
+                int v = progress + min;
+                labelView.setText(label + ": " + (label.startsWith("Brightness") ? (v + 50) : v));
+            }
+
+            @Override
+            public void onStartTrackingTouch(SeekBar bar) {
+            }
+
+            @Override
+            public void onStopTrackingTouch(SeekBar bar) {
+                listener.onValue(bar.getProgress() + min);
+            }
+        });
+        root.addView(seekBar);
+    }
+
+    private Button makeButton(String text, View.OnClickListener listener) {
+        Button button = new Button(this);
+        button.setText(text);
+        button.setGravity(Gravity.START | Gravity.CENTER_VERTICAL);
+        button.setOnClickListener(listener);
+        return button;
+    }
+
+    private Map<String, String> singleEntry(String key, String value) {
+        Map<String, String> map = new HashMap<>();
+        map.put(key, value);
+        return map;
+    }
+
+    private void applyUpdates(Map<String, String> updates, String toastMessage) {
+        try {
+            SannLabConfig.update(updates);
+            refreshStatus();
+            if (toastMessage != null) toast(toastMessage);
+        } catch (IOException e) {
+            toast("Failed to save settings: " + e.getMessage());
+        }
+    }
+
+    private void refreshStatus() {
+        SannLabConfig config = SannLabConfig.load();
+        String path = config.path.isEmpty() ? "(none)" : config.path;
+        mStatusText.setText("Type: " + config.type + "  •  AMOLED: " + (config.amoled ? "on" : "off")
+            + "\nFile: " + path);
+    }
+
+    private void toast(String message) {
+        Toast.makeText(this, message, Toast.LENGTH_SHORT).show();
+    }
+
+    private int dp(int value) {
+        return Math.round(value * getResources().getDisplayMetrics().density);
+    }
+}
