+const SECRET_KEY_RE = /\b([A-Z0-9_]*(?:TOKEN|SECRET|PASSWORD|PASSWD|API[_-]?KEY|CREDENTIAL|AUTH)[A-Z0-9_]*)\s*[:=]\s*["']?([^\s"',}]+)/gi;
